{
  "name": "@xaccefy/pi-casefile",
  "version": "0.9.4",
  "description": "Offensive security case tracker for Pi Agent \u2014 bug bounties, CTFs, security audits",
  "keywords": [
    "pi-package",
    "pi-extension",
    "xpi",
    "security",
    "bug-bounty",
    "ctf",
    "casefile"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaccefy/pi-casefile.git"
  },
  "homepage": "https://github.com/xaccefy/pi-casefile#readme",
  "bugs": {
    "url": "https://github.com/xaccefy/pi-casefile/issues"
  },
  "scripts": {
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/index.ts",
    "src/evidence.ts",
    "src/harness-verify.ts",
    "src/oob-oracle.ts",
    "src/confirmation.ts",
    "src/chains.ts",
    "src/objectives.ts",
    "src/ledger-internal.ts",
    "src/safe-state.ts",
    "src/ledger-worker.ts",
    "src/ledger-worker-entry.ts",
    "src/ledger.ts",
    "src/workflow.ts",
    "src/poc-runner.ts",
    "src/pipeline-submit.ts",
    "src/scratchpad.ts",
    "src/sqlite-compat/index.ts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "main": "src/index.ts",
  "dependencies": {
    "@xaccefy/pi-shared": "0.9.4",
    "undici": "^8.9.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
